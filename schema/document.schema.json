{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AION 2 Markdown frontmatter",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "game",
    "document_type",
    "topic",
    "region",
    "language",
    "verification",
    "source_type",
    "source_urls",
    "updated_at",
    "notify_discord"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 5
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "game": {
      "type": "string",
      "minLength": 1
    },
    "document_type": {
      "enum": [
        "knowledge",
        "news"
      ]
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "enum": [
        "global",
        "kr",
        "tw",
        "mixed"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "verification": {
      "enum": [
        "confirmed",
        "unconfirmed",
        "likely_false",
        "mixed"
      ]
    },
    "source_type": {
      "enum": [
        "official",
        "community",
        "technical",
        "mixed"
      ]
    },
    "source_urls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_at": {
      "type": "string",
      "format": "date-time"
    },
    "notify_discord": {
      "type": "boolean"
    },
    "archived": {
      "type": "boolean"
    },
    "migrated_from": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "document_type": {
            "const": "knowledge"
          }
        }
      },
      "then": {
        "properties": {
          "notify_discord": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "notify_discord": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "document_type": {
            "const": "news"
          }
        }
      }
    }
  ]
}
